generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}
// ---------- Academic structure ----------

model University {
  id          String       @id @default(uuid())
  name        String
  city        String?
  departments Department[]
  createdAt   DateTime     @default(now())
}

model Department {
  id           String       @id @default(uuid())
  name         String
  university   University   @relation(fields: [universityId], references: [id])
  universityId String
  curricula    Curriculum[]

  @@index([universityId])
}

model Curriculum {
  id           String              @id @default(uuid())
  label        String              // e.g. "Curriculum 2024"
  department   Department          @relation(fields: [departmentId], references: [id])
  departmentId String
  courses      CurriculumCourse[]
  profiles     StudentProfile[]

  @@index([departmentId])
}

// Pure catalog identity — shared across universities, holds NO content.
model Course {
  id           String              @id @default(uuid())
  title        String
  description  String?
  curricula    CurriculumCourse[]
}

// The actual thing a student experiences: Course × Curriculum × Year × Semester.
// Every content model attaches HERE, not to Course.
model CurriculumCourse {
  id           String     @id @default(uuid())
  curriculum   Curriculum @relation(fields: [curriculumId], references: [id])
  curriculumId String
  course       Course     @relation(fields: [courseId], references: [id])
  courseId     String
  courseCode   String     // local code at this university, e.g. "CS301"
  creditHours  Int?
  year         Int
  semester     Int

  materials      CourseMaterial[]
  pastExams      PastExam[]
  notes          Note[]
  quizzes        Quiz[]
  chats          ChatSession[]
  generatedExams GeneratedExam[]
  topicStats     TopicStatistic[]
  weakTopics     WeakTopic[]

  @@unique([curriculumId, courseId, year, semester]) // one row per course per curriculum-slot
  @@index([curriculumId])
  @@index([courseId])
}

// ---------- Students ----------
// (Student and StudentProfile unchanged)

enum SubscriptionPlan {
  FREE
  PRO
  UNLIMITED
}

model Student {
  id                String    @id @default(uuid())
  firstName         String
  lastName          String
  email             String    @unique
  passwordHash      String?
  googleId          String?   @unique
  emailVerified     Boolean   @default(false)
  subscriptionPlan  SubscriptionPlan @default(FREE)

  verificationToken           String?   @unique
  verificationTokenExpiresAt  DateTime?

  resetToken                  String?   @unique
  resetTokenExpiresAt         DateTime?

  refreshToken                String?   @unique
  refreshTokenExpiresAt       DateTime?

  createdAt         DateTime  @default(now())
  profile            StudentProfile?
  notes              Note[]
  flashcardReviews   FlashcardReview[]
  quizAttempts       QuizAttempt[]
  chatSessions       ChatSession[]
  generatedExamAttempts ExamAttempt[]
  weakTopics         WeakTopic[]
  upcomingEvents     UpcomingEvent[]
  activityLogs       ActivityLog[]
}

model StudentProfile {
  id              String     @id @default(uuid())
  student         Student    @relation(fields: [studentId], references: [id])
  studentId       String     @unique
  curriculum      Curriculum @relation(fields: [curriculumId], references: [id])
  curriculumId    String
  currentYear     Int
  currentSemester Int
  updatedAt       DateTime   @updatedAt
}

// ---------- Course materials (scoped to CurriculumCourse now) ----------

enum MaterialStatus {
  QUEUED
  EXTRACTING
  ANALYZING
  READY
  FAILED
  DELETED
}

model CourseMaterial {

  id          String          @id @default(uuid())
  course      Course          @relation(fields: [courseId], references: [id])
  courseId    String
  title       String
  fileUrl     String?         // null for student uploads stored in DB
  fileData    Bytes?          // binary content for student-uploaded PDFs
  status      MaterialStatus  @default(QUEUED)
  summary     String?         // AI-generated summary text OR extracted PDF text
  fileSize    Int?            // file size in bytes
  uploadedBy  String?         // studentId who uploaded
  progress    Float           @default(0) // percentage 0-100
  createdAt   DateTime        @default(now())

  chunks     MaterialChunk[]
  flashcards Flashcard[]

  @@index([courseId])
  @@index([uploadedBy])
}

// MaterialChunk, Flashcard, FlashcardReview — UNCHANGED.

// ---------- Notes ----------

model Note {
  id                  String            @id @default(uuid())
  student             Student           @relation(fields: [studentId], references: [id])
  studentId           String
  curriculumCourse    CurriculumCourse  @relation(fields: [curriculumCourseId], references: [id])
  curriculumCourseId  String
  content             String
  updatedAt           DateTime          @updatedAt

  @@index([studentId, curriculumCourseId])
}

// ---------- Quizzes ----------

model Quiz {
  id                  String            @id @default(uuid())
  curriculumCourse    CurriculumCourse  @relation(fields: [curriculumCourseId], references: [id])
  curriculumCourseId  String
  difficulty          Difficulty
  questions           QuizQuestion[]
  attempts            QuizAttempt[]
  createdAt           DateTime          @default(now())

  @@index([curriculumCourseId])
}

// QuizQuestion, QuizAttempt — UNCHANGED.

// ---------- Past exams & exam intelligence ----------

enum ExamType {
  MID
  FINAL
  QUIZ
}

model PastExam {
  id                  String          @id @default(uuid())
  curriculumCourse    CurriculumCourse @relation(fields: [curriculumCourseId], references: [id])
  curriculumCourseId  String
  year                Int
  type                ExamType
  fileUrl             String
  chunks              PastExamChunk[]

  @@index([curriculumCourseId])
}

// PastExamChunk — UNCHANGED.

model TopicStatistic {
  id                  String            @id @default(uuid())
  curriculumCourse    CurriculumCourse  @relation(fields: [curriculumCourseId], references: [id])
  curriculumCourseId  String
  topic               String
  frequency           Int
  importance          Float
  updatedAt           DateTime          @updatedAt

  @@index([curriculumCourseId])
}

// ---------- AI Tutor chat ----------

model ChatSession {
  id                  String            @id @default(uuid())
  student             Student           @relation(fields: [studentId], references: [id])
  studentId           String
  curriculumCourse    CurriculumCourse  @relation(fields: [curriculumCourseId], references: [id])
  curriculumCourseId  String
  createdAt           DateTime          @default(now())
  messages            ChatMessage[]

  @@index([studentId, curriculumCourseId])
}

// ChatMessage — UNCHANGED.

// ---------- AI-generated practice exams ----------

model GeneratedExam {
  id                  String                  @id @default(uuid())
  curriculumCourse    CurriculumCourse        @relation(fields: [curriculumCourseId], references: [id])
  curriculumCourseId  String
  strategy            String
  createdAt           DateTime                @default(now())
  questions           GeneratedExamQuestion[]
  attempts            ExamAttempt[]

  @@index([curriculumCourseId])
}

// GeneratedExamQuestion, ExamAttempt — UNCHANGED.

// ---------- Weak topics ----------

model WeakTopic {
  id                  String            @id @default(uuid())
  student             Student           @relation(fields: [studentId], references: [id])
  studentId           String
  curriculumCourse    CurriculumCourse  @relation(fields: [curriculumCourseId], references: [id])
  curriculumCourseId  String
  topic               String
  weakness            Float
  updatedAt           DateTime          @updatedAt

  @@index([studentId, courseId])
}

// ---------- Upcoming events (student-defined) ----------

model UpcomingEvent {
  id          String   @id @default(uuid())
  student     Student  @relation(fields: [studentId], references: [id])
  studentId   String
  title       String
  description String?
  eventDate   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([studentId])
  @@index([eventDate])
}

// ---------- Activity tracking ----------

model ActivityLog {
  id        String   @id @default(uuid())
  student   Student  @relation(fields: [studentId], references: [id])
  studentId String
  createdAt DateTime @default(now())

  @@index([studentId, createdAt])
}