{
    "info": {
        "name": "StudAI Backend API",
        "_postman_id": "studai-backend-api",
        "description": "Complete API collection for StudAI backend testing",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
        {
            "name": "1. Auth",
            "item": [
                {
                    "name": "Register",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"firstName\": \"John\",\n  \"lastName\": \"Doe\",\n  \"email\": \"john.doe@test.com\",\n  \"password\": \"Password123\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/auth/register",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "auth",
                                "register"
                            ]
                        }
                    }
                },
                {
                    "name": "Login",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "if (pm.response.code === 200) {",
                                    "    var jsonData = pm.response.json();",
                                    "    pm.environment.set('accessToken', jsonData.accessToken);",
                                    "    pm.environment.set('studentId', jsonData.student.id);",
                                    "}"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"email\": \"john.doe@test.com\",\n  \"password\": \"Password123\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/auth/login",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "auth",
                                "login"
                            ]
                        }
                    }
                },
                {
                    "name": "Refresh Token",
                    "request": {
                        "method": "POST",
                        "header": [],
                        "url": {
                            "raw": "{{baseUrl}}/auth/refresh",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "auth",
                                "refresh"
                            ]
                        }
                    }
                },
                {
                    "name": "Logout",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{accessToken}}"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/auth/logout",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "auth",
                                "logout"
                            ]
                        }
                    }
                },
                {
                    "name": "Forgot Password",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"email\": \"john.doe@test.com\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/auth/forgot-password",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "auth",
                                "forgot-password"
                            ]
                        }
                    }
                }
            ]
        },
        {
            "name": "2. Universities",
            "item": [
                {
                    "name": "Get All Universities",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "if (pm.response.code === 200) {",
                                    "    var jsonData = pm.response.json();",
                                    "    if (jsonData.data && jsonData.data.length > 0) {",
                                    "        pm.environment.set('universityId', jsonData.data[0].id);",
                                    "    }",
                                    "}"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{baseUrl}}/universities",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "universities"
                            ]
                        }
                    }
                },
                {
                    "name": "Get Single University",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{baseUrl}}/universities/{{universityId}}",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "universities",
                                "{{universityId}}"
                            ]
                        }
                    }
                }
            ]
        },
        {
            "name": "3. Departments",
            "item": [
                {
                    "name": "Get Departments by University",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "if (pm.response.code === 200) {",
                                    "    var jsonData = pm.response.json();",
                                    "    if (jsonData.data && jsonData.data.length > 0) {",
                                    "        pm.environment.set('departmentId', jsonData.data[0].id);",
                                    "    }",
                                    "}"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{baseUrl}}/departments/university/{{universityId}}",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "departments",
                                "university",
                                "{{universityId}}"
                            ]
                        }
                    }
                },
                {
                    "name": "Get Single Department",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{baseUrl}}/departments/{{departmentId}}",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "departments",
                                "{{departmentId}}"
                            ]
                        }
                    }
                }
            ]
        },
        {
            "name": "4. Onboarding",
            "item": [
                {
                    "name": "Complete Onboarding",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{accessToken}}"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"universityId\": \"{{universityId}}\",\n  \"departmentId\": \"{{departmentId}}\",\n  \"currentYear\": 3,\n  \"currentSemester\": 1\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/student/onboarding",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "student",
                                "onboarding"
                            ]
                        }
                    }
                }
            ]
        },
        {
            "name": "5. Courses",
            "item": [
                {
                    "name": "Get My Courses",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{accessToken}}"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/student/courses",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "student",
                                "courses"
                            ]
                        }
                    }
                }
            ]
        }
    ],
    "variable": [
        {
            "key": "baseUrl",
            "value": "http://localhost:4000/api"
        }
    ]
}