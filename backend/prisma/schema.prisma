generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model University {
  id          String       @id @default(uuid())
  name        String
  city        String?
  createdAt   DateTime     @default(now())
  shortName   String?
  departments Department[]
}

model Department {
  id           String       @id @default(uuid())
  name         String
  universityId String
  curricula    Curriculum[]
  university   University   @relation(fields: [universityId], references: [id])

  @@index([universityId])
}

model Curriculum {
  id           String             @id @default(uuid())
  label        String
  departmentId String
  department   Department         @relation(fields: [departmentId], references: [id])
  courses      CurriculumCourse[]
  profiles     StudentProfile[]

  @@index([departmentId])
}

model Course {
  id          String             @id @default(uuid())
  title       String
  description String?
  curricula   CurriculumCourse[]
}

model CurriculumCourse {
  id                String                   @id @default(uuid())
  curriculumId      String
  courseId          String
  courseCode        String
  creditHours       Int?
  year              Int
  semester          Int
  chats             ChatSession[]
  materials         CourseMaterial[]
  course            Course                   @relation(fields: [courseId], references: [id])
  curriculum        Curriculum               @relation(fields: [curriculumId], references: [id])
  generatedExams    GeneratedExam[]
  notes             Note[]
  pastExams         PastExam[]
  quizzes           Quiz[]
  studentSelections StudentCourseSelection[]
  topicStats        TopicStatistic[]
  weakTopics        WeakTopic[]

  @@unique([curriculumId, courseId, year, semester])
  @@index([curriculumId])
  @@index([courseId])
}

model UsageLog {
  id           String       @id @default(uuid())
  studentId    String
  feature      UsageFeature
  createdAt    DateTime     @default(now())
  inputTokens  Int?
  materialId   String?
  model        String?
  outputTokens Int?
  totalTokens  Int?
  student      Student      @relation(fields: [studentId], references: [id])

  @@index([studentId, feature, createdAt])
}

model Student {
  id                         String            @id @default(uuid())
  firstName                  String
  lastName                   String
  email                      String            @unique
  passwordHash               String?
  googleId                   String?           @unique
  createdAt                  DateTime          @default(now())
  emailVerified              Boolean           @default(false)
  resetToken                 String?           @unique
  resetTokenExpiresAt        DateTime?
  verificationToken          String?           @unique
  verificationTokenExpiresAt DateTime?
  refreshTokenExpiresAt      DateTime?
  refreshToken               String?
  subscriptionPlan           subscriptionPlan  @default(FREE)
  activityLogs               ActivityLog[]
  activitySessions           ActivitySession[]
  chatSessions               ChatSession[]
  generatedExamAttempts      ExamAttempt[]
  flashcardReviews           FlashcardReview[]
  notes                      Note[]
  pdfHighlights              PdfHighlight[]
  pdfNotes                   PdfNote[]
  quizAttempts               QuizAttempt[]
  profile                    StudentProfile?
  upcomingEvents             UpcomingEvent[]
  UsageLog                   UsageLog[]
  weakTopics                 WeakTopic[]
}

model StudentProfile {
  id              String                   @id @default(uuid())
  studentId       String                   @unique
  curriculumId    String
  currentYear     Int
  currentSemester Int
  updatedAt       DateTime                 @updatedAt
  selections      StudentCourseSelection[]
  curriculum      Curriculum               @relation(fields: [curriculumId], references: [id])
  student         Student                  @relation(fields: [studentId], references: [id])
}

model StudentCourseSelection {
  id                 String           @id @default(uuid())
  studentProfileId   String
  curriculumCourseId String
  createdAt          DateTime         @default(now())
  curriculumCourse   CurriculumCourse @relation(fields: [curriculumCourseId], references: [id])
  studentProfile     StudentProfile   @relation(fields: [studentProfileId], references: [id])

  @@unique([studentProfileId, curriculumCourseId])
  @@index([studentProfileId])
}

model CourseMaterial {
  id                 String           @id @default(uuid())
  title              String
  status             MaterialStatus   @default(QUEUED)
  summary            String?
  createdAt          DateTime         @default(now())
  uploadedBy         String?
  progress           Float            @default(0)
  curriculumCourseId String
  fileData           Bytes?
  fileSize           Int?
  curriculumCourse   CurriculumCourse @relation(fields: [curriculumCourseId], references: [id])
  flashcards         Flashcard[]
  chunks             MaterialChunk[]
  highlights         PdfHighlight[]
  notes              PdfNote[]

  @@index([curriculumCourseId])
  @@index([uploadedBy])
}

model MaterialChunk {
  id         String         @id @default(uuid())
  materialId String
  content    String
  page       Int?
  embedding  Float[]
  chunkIndex Int            @default(0)
  tokenCount Int?
  material   CourseMaterial @relation(fields: [materialId], references: [id])

  @@index([materialId])
  @@index([materialId, chunkIndex])
}

model Note {
  id                 String           @id @default(uuid())
  studentId          String
  content            String
  updatedAt          DateTime         @updatedAt
  curriculumCourseId String
  curriculumCourse   CurriculumCourse @relation(fields: [curriculumCourseId], references: [id])
  student            Student          @relation(fields: [studentId], references: [id])

  @@index([studentId, curriculumCourseId])
}

model Flashcard {
  id         String            @id @default(uuid())
  materialId String
  question   String
  answer     String
  createdAt  DateTime          @default(now())
  material   CourseMaterial    @relation(fields: [materialId], references: [id])
  reviews    FlashcardReview[]

  @@index([materialId])
}

model FlashcardReview {
  id          String       @id @default(uuid())
  flashcardId String
  studentId   String
  result      ReviewResult
  reviewedAt  DateTime     @default(now())
  flashcard   Flashcard    @relation(fields: [flashcardId], references: [id])
  student     Student      @relation(fields: [studentId], references: [id])

  @@index([studentId])
}

model Quiz {
  id                 String           @id @default(uuid())
  difficulty         Difficulty
  createdAt          DateTime         @default(now())
  curriculumCourseId String
  curriculumCourse   CurriculumCourse @relation(fields: [curriculumCourseId], references: [id])
  attempts           QuizAttempt[]
  questions          QuizQuestion[]

  @@index([curriculumCourseId])
}

model QuizQuestion {
  id            String @id @default(uuid())
  quizId        String
  question      String
  correctAnswer String
  choices       Json?
  quiz          Quiz   @relation(fields: [quizId], references: [id])

  @@index([quizId])
}

model QuizAttempt {
  id        String   @id @default(uuid())
  quizId    String
  studentId String
  score     Float
  answers   Json
  takenAt   DateTime @default(now())
  quiz      Quiz     @relation(fields: [quizId], references: [id])
  student   Student  @relation(fields: [studentId], references: [id])

  @@index([studentId])
}

model PastExam {
  id                 String           @id @default(uuid())
  year               Int
  type               ExamType
  fileUrl            String
  curriculumCourseId String
  curriculumCourse   CurriculumCourse @relation(fields: [curriculumCourseId], references: [id])
  chunks             PastExamChunk[]

  @@index([curriculumCourseId])
}

model PastExamChunk {
  id         String   @id @default(uuid())
  pastExamId String
  topic      String?
  question   String
  marks      Float?
  pastExam   PastExam @relation(fields: [pastExamId], references: [id])

  @@index([pastExamId])
}

model TopicStatistic {
  id                 String           @id @default(uuid())
  topic              String
  frequency          Int
  importance         Float
  updatedAt          DateTime         @updatedAt
  curriculumCourseId String
  curriculumCourse   CurriculumCourse @relation(fields: [curriculumCourseId], references: [id])

  @@index([curriculumCourseId])
}

model ChatSession {
  id                 String           @id @default(uuid())
  studentId          String
  createdAt          DateTime         @default(now())
  curriculumCourseId String
  messages           ChatMessage[]
  curriculumCourse   CurriculumCourse @relation(fields: [curriculumCourseId], references: [id])
  student            Student          @relation(fields: [studentId], references: [id])

  @@index([studentId, curriculumCourseId])
}

model ChatMessage {
  id        String      @id @default(uuid())
  sessionId String
  role      ChatRole
  content   String
  createdAt DateTime    @default(now())
  session   ChatSession @relation(fields: [sessionId], references: [id])

  @@index([sessionId])
}

model GeneratedExam {
  id                 String                  @id @default(uuid())
  strategy           String
  createdAt          DateTime                @default(now())
  curriculumCourseId String
  attempts           ExamAttempt[]
  curriculumCourse   CurriculumCourse        @relation(fields: [curriculumCourseId], references: [id])
  questions          GeneratedExamQuestion[]

  @@index([curriculumCourseId])
}

model GeneratedExamQuestion {
  id             String        @id @default(uuid())
  examId         String
  question       String
  expectedAnswer String
  topic          String?
  exam           GeneratedExam @relation(fields: [examId], references: [id])

  @@index([examId])
}

model ExamAttempt {
  id        String        @id @default(uuid())
  examId    String
  studentId String
  score     Float?
  feedback  Json?
  takenAt   DateTime      @default(now())
  exam      GeneratedExam @relation(fields: [examId], references: [id])
  student   Student       @relation(fields: [studentId], references: [id])

  @@index([studentId])
}

model WeakTopic {
  id                 String           @id @default(uuid())
  studentId          String
  topic              String
  weakness           Float
  updatedAt          DateTime         @updatedAt
  curriculumCourseId String
  curriculumCourse   CurriculumCourse @relation(fields: [curriculumCourseId], references: [id])
  student            Student          @relation(fields: [studentId], references: [id])

  @@index([studentId, curriculumCourseId])
}

model UpcomingEvent {
  id          String   @id @default(uuid())
  studentId   String
  title       String
  description String?
  eventDate   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  student     Student  @relation(fields: [studentId], references: [id])

  @@index([studentId])
  @@index([eventDate])
}

model ActivityLog {
  id        String   @id @default(uuid())
  studentId String
  createdAt DateTime @default(now())
  student   Student  @relation(fields: [studentId], references: [id])

  @@index([studentId, createdAt])
}

model ActivitySession {
  id           String    @id @default(uuid())
  studentId    String
  startedAt    DateTime
  endedAt      DateTime?
  lastActiveAt DateTime
  duration     Int       @default(0)
  createdAt    DateTime  @default(now())
  student      Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, startedAt])
  @@index([studentId, lastActiveAt])
}

model PdfHighlight {
  id          String         @id @default(uuid())
  studentId   String
  materialId  String
  pageNumber  Int
  textContent String
  position    Json
  color       String         @default("yellow")
  note        String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  material    CourseMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)
  student     Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, materialId])
  @@index([materialId])
  @@index([studentId])
}

model PdfNote {
  id         String         @id @default(uuid())
  studentId  String
  materialId String
  content    String
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  material   CourseMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)
  student    Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, materialId])
  @@index([studentId, materialId])
  @@index([materialId])
}

enum subscriptionPlan {
  FREE
  PRO
  STANDARD
}

enum UsageFeature {
  SUMMARY
  FLASHCARDS
  CHAT_MESSAGE
}
model UsageLog {
  id          String       @id @default(uuid())
  student     Student      @relation(fields: [studentId], references: [id])
  studentId   String
  feature     UsageFeature
  materialId  String?
  model       String?
  inputTokens Int?
  outputTokens Int?
  totalTokens Int?
  createdAt   DateTime     @default(now())

  @@index([studentId, feature, createdAt])
}

model Student {
  id            String  @id @default(uuid())
  firstName     String
  lastName      String
  email         String  @unique
  passwordHash  String?
  googleId      String? @unique
  emailVerified Boolean @default(false)

  verificationToken          String?   @unique
  verificationTokenExpiresAt DateTime?

  resetToken          String?   @unique
  resetTokenExpiresAt DateTime?

  refreshToken          String?
  refreshTokenExpiresAt DateTime?

  createdAt DateTime @default(now())

  profile               StudentProfile?
  notes                 Note[]
  flashcardReviews      FlashcardReview[]
  quizAttempts          QuizAttempt[]
  chatSessions          ChatSession[]
  generatedExamAttempts ExamAttempt[]
  weakTopics            WeakTopic[]
  upcomingEvents        UpcomingEvent[]
  activityLogs          ActivityLog[]
  activitySessions      ActivitySession[]
  pdfHighlights         PdfHighlight[]
  pdfNotes              PdfNote[]
  subscriptionPlan      subscriptionPlan  @default(FREE)

  UsageLog UsageLog[]

  // Performance indexes for auth operations
  @@index([email])
  @@index([googleId])
  @@index([refreshToken])
}

model StudentProfile {
  id              String     @id @default(uuid())
  student         Student    @relation(fields: [studentId], references: [id])
  studentId       String     @unique
  curriculum      Curriculum @relation(fields: [curriculumId], references: [id])
  curriculumId    String
  currentYear     Int
  currentSemester Int
  updatedAt       DateTime   @updatedAt

  selections StudentCourseSelection[]
}


// Which specific courses a student is actually taking this semester —
// not automatically every course in the curriculum's year/semester slot.
model StudentCourseSelection {
  id                 String           @id @default(uuid())
  studentProfile     StudentProfile   @relation(fields: [studentProfileId], references: [id])
  studentProfileId   String
  curriculumCourse   CurriculumCourse @relation(fields: [curriculumCourseId], references: [id])
  curriculumCourseId String
  createdAt          DateTime         @default(now())

  @@unique([studentProfileId, curriculumCourseId])
  @@index([studentProfileId])
}

// ---------- Course materials ----------

enum MaterialStatus {
  QUEUED
  EXTRACTING
  ANALYZING
  READY
  FAILED
  DELETED
}

enum ReviewResult {
  CORRECT
  WRONG
  SKIP
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum ExamType {
  MID
  FINAL
}

enum ChatRole {
  USER
  ASSISTANT
}
