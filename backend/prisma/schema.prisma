generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model University {
  id          String       @id @default(uuid())
  name        String
  city        String?
  createdAt   DateTime     @default(now())
  shortName   String?
  departments Department[]
}

model Department {
  id           String       @id @default(uuid())
  name         String
  universityId String
  curricula    Curriculum[]
  university   University   @relation(fields: [universityId], references: [id])

  @@index([universityId])
}

model Curriculum {
  id           String             @id @default(uuid())
  label        String
  departmentId String
  department   Department         @relation(fields: [departmentId], references: [id])
  courses      CurriculumCourse[]
  profiles     StudentProfile[]

  @@index([departmentId])
}

model Course {
  id          String             @id @default(uuid())
  title       String
  description String?
  curricula   CurriculumCourse[]
}

model CurriculumCourse {
  id                String                   @id @default(uuid())
  curriculumId      String
  courseId          String
  courseCode        String
  creditHours       Int?
  year              Int
  semester          Int
  chats             ChatSession[]
  materials         CourseMaterial[]
  course            Course                   @relation(fields: [courseId], references: [id])
  curriculum        Curriculum               @relation(fields: [curriculumId], references: [id])
  generatedExams    GeneratedExam[]
  notes             Note[]
  pastExams         PastExam[]
  quizzes           Quiz[]
  studentSelections StudentCourseSelection[]
  topicStats        TopicStatistic[]
  weakTopics        WeakTopic[]

  @@unique([curriculumId, courseId, year, semester])
  @@index([curriculumId])
  @@index([courseId])
}

model UsageLog {
  id           String       @id @default(uuid())
  studentId    String
  feature      UsageFeature
  createdAt    DateTime     @default(now())
  inputTokens  Int?
  materialId   String?
  model        String?
  outputTokens Int?
  totalTokens  Int?
  student      Student      @relation(fields: [studentId], references: [id])

  @@index([studentId, feature, createdAt])
}

model Student {
  id                         String            @id @default(uuid())
  firstName                  String
  lastName                   String
  email                      String            @unique
  passwordHash               String?
  googleId                   String?           @unique
  createdAt                  DateTime          @default(now())
  emailVerified              Boolean           @default(false)
  resetToken                 String?           @unique
  resetTokenExpiresAt        DateTime?
  verificationToken          String?           @unique
  verificationTokenExpiresAt DateTime?
  refreshTokenExpiresAt      DateTime?
  refreshToken               String?
  subscriptionPlan           subscriptionPlan  @default(FREE)
  subscriptionExpiresAt      DateTime?
  activityLogs               ActivityLog[]
  activitySessions           ActivitySession[]
  chatSessions               ChatSession[]
  generatedExamAttempts      ExamAttempt[]
  flashcardReviews           FlashcardReview[]
  notes                      Note[]
  pdfHighlights              PdfHighlight[]
  pdfNotes                   PdfNote[]
  quizAttempts               QuizAttempt[]
  profile                    StudentProfile?
  upcomingEvents             UpcomingEvent[]
  UsageLog                   UsageLog[]
  weakTopics                 WeakTopic[]
  courseMaterials            CourseMaterial[]
  payments                   Payment[]
  subscriptionHistory        SubscriptionHistory[]
  studySessions              StudySession[]
  studyStreak                StudyStreak?
  bookmarks                  Bookmark[]
  createdGroups              StudyGroup[]       @relation("CreatedGroups")
  studyGroupMemberships      StudyGroupMember[]
  sentMessages               GroupMessage[]
  sharedNotes                GroupSharedNote[]
}

model StudentProfile {
  id              String                   @id @default(uuid())
  studentId       String                   @unique
  curriculumId    String
  currentYear     Int
  currentSemester Int
  updatedAt       DateTime                 @updatedAt
  selections      StudentCourseSelection[]
  curriculum      Curriculum               @relation(fields: [curriculumId], references: [id])
  student         Student                  @relation(fields: [studentId], references: [id])
}

model CourseMaterial {
  id                 String           @id @default(uuid())
  title              String
  status             MaterialStatus   @default(QUEUED)
  summary            String?
  createdAt          DateTime         @default(now())
  deletedAt          DateTime?
  uploadedBy         String?
  progress           Float            @default(0)
  curriculumCourseId String
  fileData           Bytes?
  fileSize           Int?
  storagePath        String?
  processingError    String?
  curriculumCourse   CurriculumCourse @relation(fields: [curriculumCourseId], references: [id])
  student            Student?         @relation(fields: [uploadedBy], references: [id], onDelete: SetNull)
  flashcards         Flashcard[]
  chunks             MaterialChunk[]
  highlights         PdfHighlight[]
  notes              PdfNote[]
  quizzes            Quiz[]
  bookmarks          Bookmark[]

  @@index([curriculumCourseId])
  @@index([uploadedBy])
  @@index([status])
}

model MaterialChunk {
  id         String         @id @default(uuid())
  materialId String
  content    String
  page       Int?
  embedding  Float[]
  chunkIndex Int            @default(0)
  tokenCount Int?
  material   CourseMaterial @relation(fields: [materialId], references: [id])

  @@index([materialId])
  @@index([materialId, chunkIndex])
}

model Note {
  id                 String            @id @default(uuid())
  studentId          String
  content            String
  updatedAt          DateTime          @updatedAt
  curriculumCourseId String
  curriculumCourse   CurriculumCourse  @relation(fields: [curriculumCourseId], references: [id])
  student            Student           @relation(fields: [studentId], references: [id])
  sharedInGroups     GroupSharedNote[]

  @@index([studentId, curriculumCourseId])
}

model Flashcard {
  id         String            @id @default(uuid())
  materialId String
  question   String
  answer     String
  createdAt  DateTime          @default(now())
  material   CourseMaterial    @relation(fields: [materialId], references: [id])
  reviews    FlashcardReview[]

  @@index([materialId])
}

model FlashcardReview {
  id          String       @id @default(uuid())
  flashcardId String
  studentId   String
  result      ReviewResult
  reviewedAt  DateTime     @default(now())
  flashcard   Flashcard    @relation(fields: [flashcardId], references: [id])
  student     Student      @relation(fields: [studentId], references: [id])

  @@index([studentId])
}

model Quiz {
  id                 String           @id @default(uuid())
  difficulty         Difficulty
  createdAt          DateTime         @default(now())
  curriculumCourseId String
  materialId         String?
  curriculumCourse   CurriculumCourse @relation(fields: [curriculumCourseId], references: [id])
  material           CourseMaterial?  @relation(fields: [materialId], references: [id], onDelete: Cascade)
  attempts           QuizAttempt[]
  questions          QuizQuestion[]

  @@index([curriculumCourseId])
  @@index([materialId])
}

model QuizQuestion {
  id            String       @id @default(uuid())
  quizId        String
  question      String
  questionType  QuestionType @default(MULTIPLE_CHOICE)
  correctAnswer String
  choices       Json?
  quiz          Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([quizId])
}

model QuizAttempt {
  id        String   @id @default(uuid())
  quizId    String
  studentId String
  score     Float
  answers   Json
  takenAt   DateTime @default(now())
  quiz      Quiz     @relation(fields: [quizId], references: [id])
  student   Student  @relation(fields: [studentId], references: [id])

  @@index([studentId])
}

model PastExam {
  id                 String        @id @default(uuid())
  year               Int
  type               ExamType
  fileUrl            String
  status             ExamStatus    @default(QUEUED)
  curriculumCourseId String
  uploadedBy         String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  processingError    String?
  curriculumCourse   CurriculumCourse @relation(fields: [curriculumCourseId], references: [id], onDelete: Cascade)
  chunks             PastExamChunk[]

  @@index([curriculumCourseId])
  @@index([status])
  @@index([uploadedBy])
}

model PastExamChunk {
  id            String       @id @default(uuid())
  pastExamId    String
  topic         String?
  question      String
  questionType  QuestionType @default(MULTIPLE_CHOICE)
  options       Json?        // Array of options e.g., ["A) Option 1", "B) Option 2"]
  correctAnswer String
  explanation   String?      // Detailed AI-generated explanation
  marks         Float?
  status        ChunkStatus  @default(EXTRACTED)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  pastExam      PastExam     @relation(fields: [pastExamId], references: [id], onDelete: Cascade)

  @@index([pastExamId])
  @@index([topic])
  @@index([questionType])
}

model TopicStatistic {
  id                 String           @id @default(uuid())
  topic              String
  frequency          Int
  importance         Float
  updatedAt          DateTime         @updatedAt
  curriculumCourseId String
  curriculumCourse   CurriculumCourse @relation(fields: [curriculumCourseId], references: [id])

  @@index([curriculumCourseId])
}

model ChatSession {
  id                 String           @id @default(uuid())
  studentId          String
  createdAt          DateTime         @default(now())
  curriculumCourseId String
  messages           ChatMessage[]
  curriculumCourse   CurriculumCourse @relation(fields: [curriculumCourseId], references: [id])
  student            Student          @relation(fields: [studentId], references: [id])

  @@index([studentId, curriculumCourseId])
}

model ChatMessage {
  id        String      @id @default(uuid())
  sessionId String
  role      ChatRole
  content   String
  createdAt DateTime    @default(now())
  session   ChatSession @relation(fields: [sessionId], references: [id])

  @@index([sessionId])
}

model GeneratedExam {
  id                 String                  @id @default(uuid())
  strategy           String
  createdAt          DateTime                @default(now())
  curriculumCourseId String
  attempts           ExamAttempt[]
  curriculumCourse   CurriculumCourse        @relation(fields: [curriculumCourseId], references: [id])
  questions          GeneratedExamQuestion[]

  @@index([curriculumCourseId])
}

model GeneratedExamQuestion {
  id             String        @id @default(uuid())
  examId         String
  question       String
  expectedAnswer String
  topic          String?
  exam           GeneratedExam @relation(fields: [examId], references: [id])

  @@index([examId])
}

model ExamAttempt {
  id        String        @id @default(uuid())
  examId    String
  studentId String
  score     Float?
  feedback  Json?
  takenAt   DateTime      @default(now())
  exam      GeneratedExam @relation(fields: [examId], references: [id])
  student   Student       @relation(fields: [studentId], references: [id])

  @@index([studentId])
}

model WeakTopic {
  id                 String           @id @default(uuid())
  studentId          String
  topic              String
  weakness           Float
  updatedAt          DateTime         @updatedAt
  curriculumCourseId String
  curriculumCourse   CurriculumCourse @relation(fields: [curriculumCourseId], references: [id])
  student            Student          @relation(fields: [studentId], references: [id])

  @@index([studentId, curriculumCourseId])
}

model UpcomingEvent {
  id          String   @id @default(uuid())
  studentId   String
  title       String
  description String?
  eventDate   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  student     Student  @relation(fields: [studentId], references: [id])

  @@index([studentId])
  @@index([eventDate])
}

model ActivityLog {
  id        String   @id @default(uuid())
  studentId String
  createdAt DateTime @default(now())
  student   Student  @relation(fields: [studentId], references: [id])

  @@index([studentId, createdAt])
}

model ActivitySession {
  id           String    @id @default(uuid())
  studentId    String
  startedAt    DateTime
  endedAt      DateTime?
  lastActiveAt DateTime
  duration     Int       @default(0)
  createdAt    DateTime  @default(now())
  student      Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, startedAt])
  @@index([studentId, lastActiveAt])
}

model PdfHighlight {
  id          String         @id @default(uuid())
  studentId   String
  materialId  String
  pageNumber  Int
  textContent String
  position    Json
  color       String         @default("yellow")
  note        String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  material    CourseMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)
  student     Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, materialId])
  @@index([materialId])
  @@index([studentId])
}

model PdfNote {
  id         String         @id @default(uuid())
  studentId  String
  materialId String
  content    String
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  material   CourseMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)
  student    Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, materialId])
  @@index([studentId, materialId])
  @@index([materialId])
}

model StudentCourseSelection {
  id                 String           @id @default(uuid())
  studentProfileId   String
  curriculumCourseId String
  createdAt          DateTime         @default(now())
  curriculumCourse   CurriculumCourse @relation(fields: [curriculumCourseId], references: [id])
  studentProfile     StudentProfile   @relation(fields: [studentProfileId], references: [id])

  @@unique([studentProfileId, curriculumCourseId])
  @@index([studentProfileId])
}

// ========= NEW FEATURES: Study Sessions, Bookmarks, Study Groups =========

model StudySession {
  id             String         @id @default(uuid())
  studentId      String
  courseId       String?
  materialId     String?
  startTime      DateTime       @default(now())
  endTime        DateTime?
  duration       Int            @default(0) // in minutes
  type           SessionType    @default(REGULAR)
  pomodoroCount  Int            @default(0)
  status         SessionStatus  @default(ACTIVE)
  createdAt      DateTime       @default(now())
  student        Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, status])
  @@index([studentId, startTime])
  @@index([startTime])
}

model StudyStreak {
  id            String    @id @default(uuid())
  studentId     String    @unique
  currentStreak Int       @default(0)
  longestStreak Int       @default(0)
  lastStudyDate DateTime?
  totalMinutes  Int       @default(0)
  totalSessions Int       @default(0)
  updatedAt     DateTime  @updatedAt
  student       Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
}

model Bookmark {
  id            String         @id @default(uuid())
  studentId     String
  materialId    String
  name          String
  pageNumber    Int
  textSelection Json? // { startOffset, endOffset, selectedText }
  color         String?        @default("yellow")
  note          String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  material      CourseMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)
  student       Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, materialId])
  @@index([materialId])
}

model StudyGroup {
  id                String              @id @default(uuid())
  name              String
  subject           String?
  curriculumCourseId String?
  inviteCode        String              @unique
  createdById       String
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  createdBy         Student             @relation("CreatedGroups", fields: [createdById], references: [id], onDelete: Cascade)
  members           StudyGroupMember[]
  messages          GroupMessage[]
  sharedNotes       GroupSharedNote[]

  @@index([inviteCode])
  @@index([createdById])
}

model StudyGroupMember {
  id           String          @id @default(uuid())
  studyGroupId String
  studentId    String
  role         GroupMemberRole @default(MEMBER)
  joinedAt     DateTime        @default(now())
  studyGroup   StudyGroup      @relation(fields: [studyGroupId], references: [id], onDelete: Cascade)
  student      Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studyGroupId, studentId])
  @@index([studentId])
  @@index([studyGroupId])
}

model GroupMessage {
  id               String      @id @default(uuid())
  studyGroupId     String
  senderId         String
  content          String
  type             MessageType @default(TEXT)
  sharedResourceId String?
  createdAt        DateTime    @default(now())
  studyGroup       StudyGroup  @relation(fields: [studyGroupId], references: [id], onDelete: Cascade)
  sender           Student     @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([studyGroupId, createdAt])
  @@index([senderId])
}

model GroupSharedNote {
  id           String     @id @default(uuid())
  studyGroupId String
  noteId       String
  sharedById   String
  sharedAt     DateTime   @default(now())
  studyGroup   StudyGroup @relation(fields: [studyGroupId], references: [id], onDelete: Cascade)
  note         Note       @relation(fields: [noteId], references: [id], onDelete: Cascade)
  sharedBy     Student    @relation(fields: [sharedById], references: [id], onDelete: Cascade)

  @@index([studyGroupId])
  @@index([noteId])
}

enum subscriptionPlan {
  FREE
  STUDENT
  PRO
  STANDARD
}

enum UsageFeature {
  SUMMARY
  FLASHCARDS
  CHAT_MESSAGES
  NOTES_GENERATION
  QUIZ_GENERATION
  PDF_UPLOADS
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
  REFUNDED
}

enum PaymentProvider {
  CHAPA
  MANUAL
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

enum MaterialStatus {
  QUEUED
  EXTRACTING
  ANALYZING
  READY
  FAILED
  DELETED
}

enum ReviewResult {
  CORRECT
  WRONG
  SKIP
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum ExamType {
  MID
  FINAL
}

enum ExamStatus {
  QUEUED
  PROCESSING
  NEEDS_REVIEW
  READY
  FAILED
}

enum QuestionType {
  TRUE_FALSE
  MULTIPLE_CHOICE
  SHORT_ANSWER
  ESSAY
}

enum ChunkStatus {
  EXTRACTED
  NEEDS_REVIEW
  VERIFIED
  REJECTED
}

enum ChatRole {
  USER
  ASSISTANT
}

enum SessionType {
  REGULAR
  POMODORO
}

enum SessionStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum GroupMemberRole {
  ADMIN
  MEMBER
}

enum MessageType {
  TEXT
  NOTE_SHARE
  FLASHCARD_SHARE
}

model Payment {
  id              String          @id @default(uuid())
  studentId       String
  amount          Float
  currency        String          @default("ETB")
  status          PaymentStatus   @default(PENDING)
  provider        PaymentProvider @default(CHAPA)
  transactionRef  String          @unique
  chapaReference  String?
  planUpgraded    subscriptionPlan
  billingCycle    BillingCycle
  metadata        Json?
  providerResponse Json?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  completedAt     DateTime?
  student         Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([status])
  @@index([transactionRef])
  @@index([createdAt])
}

model SubscriptionHistory {
  id              String           @id @default(uuid())
  studentId       String
  previousPlan    subscriptionPlan
  newPlan         subscriptionPlan
  changedAt       DateTime         @default(now())
  expiresAt       DateTime?
  reason          String?
  paymentId       String?
  isActive        Boolean          @default(true)
  student         Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([isActive])
  @@index([changedAt])
}
