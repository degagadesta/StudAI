generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

// ---------- Academic structure ----------

model University {
  id          String       @id @default(uuid())
  name        String
  shortName   String?
  city        String?
  departments Department[]
  createdAt   DateTime     @default(now())
}

model Department {
  id           String       @id @default(uuid())
  name         String
  university   University   @relation(fields: [universityId], references: [id])
  universityId String
  curricula    Curriculum[]

  @@index([universityId])
}

model Curriculum {
  id           String             @id @default(uuid())
  label        String // e.g. "Curriculum 2024"
  department   Department         @relation(fields: [departmentId], references: [id])
  departmentId String
  courses      CurriculumCourse[]
  profiles     StudentProfile[]

  @@index([departmentId])
}

// Pure catalog identity — shared across universities, holds NO content.
model Course {
  id          String             @id @default(uuid())
  title       String
  description String?
  curricula   CurriculumCourse[]
}

// The actual thing a student experiences: Course × Curriculum × Year × Semester.
// Every content model attaches HERE, not to Course — this is what prevents
// content from one university leaking into another's students.
model CurriculumCourse {
  id           String     @id @default(uuid())
  curriculum   Curriculum @relation(fields: [curriculumId], references: [id])
  curriculumId String
  course       Course     @relation(fields: [courseId], references: [id])
  courseId     String
  courseCode   String // local code at this university, e.g. "CS301"
  creditHours  Int?
  year         Int
  semester     Int

  materials         CourseMaterial[]
  pastExams         PastExam[]
  notes             Note[]
  quizzes           Quiz[]
  chats             ChatSession[]
  generatedExams    GeneratedExam[]
  topicStats        TopicStatistic[]
  weakTopics        WeakTopic[]
  studentSelections StudentCourseSelection[]

  @@unique([curriculumId, courseId, year, semester])
  @@index([curriculumId])
  @@index([courseId])
}

// ---------- Students ----------

enum subscriptionPlan {
  FREE
  PRO
}

model Student {
  id            String  @id @default(uuid())
  firstName     String
  lastName      String
  email         String  @unique
  passwordHash  String?
  googleId      String? @unique
  emailVerified Boolean @default(false)

  verificationToken          String?   @unique
  verificationTokenExpiresAt DateTime?

  resetToken          String?   @unique
  resetTokenExpiresAt DateTime?

  refreshToken          String?
  refreshTokenExpiresAt DateTime?

  createdAt DateTime @default(now())

  profile               StudentProfile?
  notes                 Note[]
  flashcardReviews      FlashcardReview[]
  quizAttempts          QuizAttempt[]
  chatSessions          ChatSession[]
  generatedExamAttempts ExamAttempt[]
  weakTopics            WeakTopic[]
  upcomingEvents        UpcomingEvent[]
  activityLogs          ActivityLog[]
  activitySessions      ActivitySession[]
  subscriptionPlan      subscriptionPlan  @default(FREE)
}

model StudentProfile {
  id              String     @id @default(uuid())
  student         Student    @relation(fields: [studentId], references: [id])
  studentId       String     @unique
  curriculum      Curriculum @relation(fields: [curriculumId], references: [id])
  curriculumId    String
  currentYear     Int
  currentSemester Int
  updatedAt       DateTime   @updatedAt

  selections StudentCourseSelection[]
}


// Which specific courses a student is actually taking this semester —
// not automatically every course in the curriculum's year/semester slot.
model StudentCourseSelection {
  id                 String           @id @default(uuid())
  studentProfile     StudentProfile   @relation(fields: [studentProfileId], references: [id])
  studentProfileId   String
  curriculumCourse   CurriculumCourse @relation(fields: [curriculumCourseId], references: [id])
  curriculumCourseId String
  createdAt          DateTime         @default(now())

  @@unique([studentProfileId, curriculumCourseId])
  @@index([studentProfileId])
}

// ---------- Course materials ----------

enum MaterialStatus {
  QUEUED
  EXTRACTING
  ANALYZING
  READY
  FAILED
  DELETED // set by pdf.service.js on soft-delete
}

model CourseMaterial {
  id                 String              @id @default(uuid())
  curriculumCourse   CurriculumCourse    @relation(fields: [curriculumCourseId], references: [id])
  curriculumCourseId String
  title              String
  fileData           Bytes?              // raw PDF bytes — set on upload, cleared on soft-delete
  fileSize           Int?
  status             MaterialStatus      @default(QUEUED)
  summary            String?
  uploadedBy         String?             // studentId who uploaded
  progress           Float               @default(0) // 0-100, reading progress
  createdAt          DateTime            @default(now())

  chunks     MaterialChunk[]
  flashcards Flashcard[]

  @@index([curriculumCourseId])
  @@index([uploadedBy])
}

model MaterialChunk {
  id         String         @id @default(uuid())
  material   CourseMaterial @relation(fields: [materialId], references: [id])
  materialId String
  content    String
  page       Int?

  @@index([materialId])
}

// ---------- Notes ----------

model Note {
  id                 String           @id @default(uuid())
  student            Student          @relation(fields: [studentId], references: [id])
  studentId          String
  curriculumCourse   CurriculumCourse @relation(fields: [curriculumCourseId], references: [id])
  curriculumCourseId String
  content            String
  updatedAt          DateTime         @updatedAt

  @@index([studentId, curriculumCourseId])
}

// ---------- Flashcards ----------

model Flashcard {
  id         String            @id @default(uuid())
  material   CourseMaterial    @relation(fields: [materialId], references: [id])
  materialId String
  question   String
  answer     String
  reviews    FlashcardReview[]

  @@index([materialId])
}

enum ReviewResult {
  CORRECT
  WRONG
  SKIP
}

model FlashcardReview {
  id          String       @id @default(uuid())
  flashcard   Flashcard    @relation(fields: [flashcardId], references: [id])
  flashcardId String
  student     Student      @relation(fields: [studentId], references: [id])
  studentId   String
  result      ReviewResult
  reviewedAt  DateTime     @default(now())

  @@index([studentId])
}

// ---------- Quizzes ----------

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

model Quiz {
  id                 String           @id @default(uuid())
  curriculumCourse   CurriculumCourse @relation(fields: [curriculumCourseId], references: [id])
  curriculumCourseId String
  difficulty         Difficulty
  questions          QuizQuestion[]
  attempts           QuizAttempt[]
  createdAt          DateTime         @default(now())

  @@index([curriculumCourseId])
}

model QuizQuestion {
  id            String @id @default(uuid())
  quiz          Quiz   @relation(fields: [quizId], references: [id])
  quizId        String
  question      String
  correctAnswer String
  choices       Json?

  @@index([quizId])
}

model QuizAttempt {
  id        String   @id @default(uuid())
  quiz      Quiz     @relation(fields: [quizId], references: [id])
  quizId    String
  student   Student  @relation(fields: [studentId], references: [id])
  studentId String
  score     Float
  answers   Json
  takenAt   DateTime @default(now())

  @@index([studentId])
}

// ---------- Past exams & exam intelligence ----------



enum ExamType {
  MID
  FINAL
}

model PastExam {
  id                 String           @id @default(uuid())
  curriculumCourse   CurriculumCourse @relation(fields: [curriculumCourseId], references: [id])
  curriculumCourseId String
  year               Int
  type               ExamType
  fileUrl            String
  chunks             PastExamChunk[]

  @@index([curriculumCourseId])
}

model PastExamChunk {
  id         String   @id @default(uuid())
  pastExam   PastExam @relation(fields: [pastExamId], references: [id])
  pastExamId String
  topic      String?
  question   String
  marks      Float?

  @@index([pastExamId])
}

model TopicStatistic {
  id                 String           @id @default(uuid())
  curriculumCourse   CurriculumCourse @relation(fields: [curriculumCourseId], references: [id])
  curriculumCourseId String
  topic              String
  frequency          Int
  importance         Float
  updatedAt          DateTime         @updatedAt

  @@index([curriculumCourseId])
}

// ---------- AI Tutor chat ----------

model ChatSession {
  id                 String           @id @default(uuid())
  student            Student          @relation(fields: [studentId], references: [id])
  studentId          String
  curriculumCourse   CurriculumCourse @relation(fields: [curriculumCourseId], references: [id])
  curriculumCourseId String
  createdAt          DateTime         @default(now())
  messages           ChatMessage[]

  @@index([studentId, curriculumCourseId])
}

enum ChatRole {
  USER
  ASSISTANT
}

model ChatMessage {
  id        String      @id @default(uuid())
  session   ChatSession @relation(fields: [sessionId], references: [id])
  sessionId String
  role      ChatRole
  content   String
  createdAt DateTime    @default(now())

  @@index([sessionId])
}

// ---------- AI-generated practice exams ----------

model GeneratedExam {
  id                 String                  @id @default(uuid())
  curriculumCourse   CurriculumCourse        @relation(fields: [curriculumCourseId], references: [id])
  curriculumCourseId String
  strategy           String
  createdAt          DateTime                @default(now())
  questions          GeneratedExamQuestion[]
  attempts           ExamAttempt[]

  @@index([curriculumCourseId])
}

model GeneratedExamQuestion {
  id             String        @id @default(uuid())
  exam           GeneratedExam @relation(fields: [examId], references: [id])
  examId         String
  question       String
  expectedAnswer String
  topic          String?

  @@index([examId])
}

model ExamAttempt {
  id        String        @id @default(uuid())
  exam      GeneratedExam @relation(fields: [examId], references: [id])
  examId    String
  student   Student       @relation(fields: [studentId], references: [id])
  studentId String
  score     Float?
  feedback  Json?
  takenAt   DateTime      @default(now())

  @@index([studentId])
}

// ---------- Weak topics ----------

model WeakTopic {
  id                 String           @id @default(uuid())
  student            Student          @relation(fields: [studentId], references: [id])
  studentId          String
  curriculumCourse   CurriculumCourse @relation(fields: [curriculumCourseId], references: [id])
  curriculumCourseId String
  topic              String
  weakness           Float
  updatedAt          DateTime         @updatedAt

  @@index([studentId, curriculumCourseId])
}

// ---------- Upcoming events (student-defined) ----------

model UpcomingEvent {
  id          String   @id @default(uuid())
  student     Student  @relation(fields: [studentId], references: [id])
  studentId   String
  title       String
  description String?
  eventDate   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([studentId])
  @@index([eventDate])
}

// ---------- Activity tracking ----------

model ActivityLog {
  id        String   @id @default(uuid())
  student   Student  @relation(fields: [studentId], references: [id])
  studentId String
  createdAt DateTime @default(now())

  @@index([studentId, createdAt])
}

model ActivitySession {
  id           String    @id @default(uuid())
  student      Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId    String
  startedAt    DateTime
  endedAt      DateTime?
  lastActiveAt DateTime
  duration     Int       @default(0) // seconds
  createdAt    DateTime  @default(now())

  @@index([studentId, startedAt])
  @@index([studentId, lastActiveAt])
}
